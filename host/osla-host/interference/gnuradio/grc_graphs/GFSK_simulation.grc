      [('0', 'complex', 1), ('1', 'complex', 1), ('2', 'complex', 1)], [('0', 'complex',
      1), ('Debug', 'message', 1)], 'Embedded Python Block Noise Controller', ['Pr',
      'noise_length', 'sampling_rate'])
