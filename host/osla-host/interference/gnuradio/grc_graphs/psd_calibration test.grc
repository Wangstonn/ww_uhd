options:
  parameters:
    author: Winston Wang
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Transmits constant interference for a target noise level. Used to
      verify the psd logic is correct.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: psd_calibration_test
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: psd_calibration_test
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: BLE_fd
  id: variable
  parameters:
    comment: BLE frequency deviation
    value: '250000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 488.0]
    rotation: 0
    state: true
- name: BLE_sym_length
  id: variable
  parameters:
    comment: ''
    value: '.000001'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 560.0]
    rotation: 0
    state: enabled
